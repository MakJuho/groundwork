{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Groundwork flow trace",
  "type": "object",
  "required": ["id", "title", "outcome", "trigger", "actors", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "흐름 id, 출력 폴더명으로 쓰임. 자동 선택이면 API 항목 id 소문자(예: loa-001)" },
    "title": { "type": "string", "description": "업무 언어로 쓴 흐름 이름, 예: 도서 대출" },
    "outcome": { "type": "string", "description": "흐름이 끝났을 때의 업무상 결과 한 문장" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "trigger": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["api", "batch", "event", "ui", "message"] },
        "label": { "type": "string", "description": "시작점 이름. api면 '<METHOD> <경로>', 예: POST /api/loans" },
        "module": { "type": "string", "description": "시작점이 속한 모듈 id" },
        "screen": { "type": "string", "description": "(선택) UI 시작점이 속한 화면 이름" },
        "component": { "type": "string", "description": "(선택) UI 시작점 컴포넌트(버튼 등) 이름" },
        "factId": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d{3}$", "description": "시작점에 해당하는 facts 항목 id" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "kind": { "enum": ["client", "component", "db", "external", "batch"] },
          "name": { "type": "string", "description": "업무 언어 이름, 예: 대출 처리, 회원, 결제 대행사" },
          "module": { "type": "string" },
          "layer": { "enum": ["screen", "common", "controller", "service", "mapper", "db", "external", "other"], "description": "(선택) 배우가 속한 계층" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "from", "to", "action", "evidence", "confidence"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "description": "1부터 차례로" },
          "from": { "type": "string", "description": "actors의 id" },
          "to": { "type": "string", "description": "actors의 id" },
          "action": { "type": "string", "description": "업무 언어로 쓴 동작. 코드 식별자 금지" },
          "call": { "type": "string", "description": "코드상 호출, 예: LoanService.borrow" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "facts.schema.json#/properties/items/items/properties/evidence/items" } },
          "data": {
            "type": "object",
            "properties": {
              "reads": { "type": "array", "items": { "type": "string" }, "description": "읽는 엔티티 또는 테이블 이름(컬럼 제외)" },
              "writes": { "type": "array", "items": { "type": "string" }, "description": "쓰는 엔티티 또는 테이블 이름(컬럼 제외)" }
            }
          },
          "policies": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d{3}$" }, "description": "이 단계에서 적용되는 facts 항목 id" },
          "branch": {
            "type": "object",
            "required": ["condition", "result"],
            "properties": {
              "condition": { "type": "string", "description": "업무 언어, 예: 이미 3권을 빌린 상태" },
              "result": { "type": "string", "description": "업무 언어, 예: 대출 거부, '동시에 3권까지' 안내" }
            }
          },
          "payload": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "description": "주고받는 데이터 이름, 예: ds_member" },
              "fields": { "type": "array", "items": { "type": "string" }, "description": "주요 필드 이름" },
              "example": { "type": "string", "description": "예시 값" }
            },
            "description": "(선택) 이 단계에서 오가는 데이터"
          },
          "branchOf": { "type": "integer", "minimum": 1, "description": "(선택) 이 단계가 갈라져 나온 앞 단계 번호. 그 단계에 branch가 있어야 하고 자기 번호보다 작아야 한다" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "verifyFailed": { "type": "boolean", "description": "verify-citations가 근거 검증 실패 시 쓴다. 직접 쓰지 않는다" },
          "originalConfidence": { "enum": ["high", "medium", "low"], "description": "verify-citations가 low로 낮추기 전의 신뢰도. 나중에 검증이 통과하면 되돌린다. 직접 쓰지 않는다" }
        }
      }
    }
  }
}
