<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="DlvMng" width="1280" height="760" titletext="배송 관리" onload="DlvMng_onload">
    <Layouts>
      <Layout height="760" width="1280">
        <Static id="sta_title" taborder="0" text="배송 관리" left="20" top="12" width="200" height="30"/>
        <Static id="sta_ordDt" taborder="1" text="주문일" left="20" top="56" width="50" height="28"/>
        <Calendar id="cal_from" taborder="2" left="72" top="56" width="120" height="28" dateformat="yyyy-MM-dd"/>
        <Static id="sta_wave" taborder="3" text="~" left="196" top="56" width="14" height="28"/>
        <Calendar id="cal_to" taborder="4" left="214" top="56" width="120" height="28" dateformat="yyyy-MM-dd"/>
        <Static id="sta_dlvStat" taborder="5" text="배송상태" left="354" top="56" width="60" height="28"/>
        <Combo id="cbo_dlvStat" taborder="6" left="416" top="56" width="110" height="28" innerdataset="ds_dlvStatSrch" codecolumn="CD" datacolumn="CD_NM"/>
        <Static id="sta_carrier" taborder="7" text="택배사" left="546" top="56" width="50" height="28"/>
        <Combo id="cbo_carrier" taborder="8" left="598" top="56" width="120" height="28" innerdataset="ds_carrier" codecolumn="CD" datacolumn="CD_NM"/>
        <Static id="sta_ordNo" taborder="9" text="주문번호" left="738" top="56" width="60" height="28"/>
        <Edit id="edt_ordNo" taborder="10" left="800" top="56" width="150" height="28"/>
        <Static id="sta_invcNo" taborder="11" text="송장번호" left="966" top="56" width="60" height="28"/>
        <Edit id="edt_invcNo" taborder="12" left="1028" top="56" width="140" height="28"/>
        <Button id="btn_search" taborder="13" text="조회" left="1184" top="56" width="76" height="28" onclick="btn_search_onclick"/>
        <Static id="sta_bulkCarrier" taborder="14" text="일괄 택배사" left="20" top="100" width="80" height="28"/>
        <Combo id="cbo_bulkCarrier" taborder="15" left="102" top="100" width="120" height="28" innerdataset="ds_carrier" codecolumn="CD" datacolumn="CD_NM"/>
        <Button id="btn_bulkCarrier" taborder="16" text="적용" left="226" top="100" width="60" height="28" onclick="btn_bulkCarrier_onclick"/>
        <Button id="btn_ship" taborder="17" text="출고" left="958" top="100" width="96" height="28" onclick="btn_ship_onclick"/>
        <Button id="btn_complete" taborder="18" text="배송완료" left="1060" top="100" width="96" height="28" onclick="btn_complete_onclick"/>
        <Button id="btn_track" taborder="19" text="배송조회" left="1162" top="100" width="96" height="28" onclick="btn_track_onclick"/>
        <Grid id="grd_dlv" taborder="20" binddataset="ds_dlv" left="20" top="138" width="1240" height="400" autoenter="select">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="30"/>
                <Column size="140"/>
                <Column size="140"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="110"/>
                <Column size="60"/>
                <Column size="250"/>
                <Column size="60"/>
                <Column size="70"/>
                <Column size="110"/>
                <Column size="120"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row size="30" band="head"/>
                <Row size="30"/>
              </Rows>
              <Band id="head">
                <Cell displaytype="checkboxcontrol" edittype="checkbox" text="0"/>
                <Cell col="1" text="배송번호"/>
                <Cell col="2" text="주문번호"/>
                <Cell col="3" text="주문일"/>
                <Cell col="4" text="배송상태"/>
                <Cell col="5" text="수령인"/>
                <Cell col="6" text="연락처"/>
                <Cell col="7" text="우편번호"/>
                <Cell col="8" text="주소"/>
                <Cell col="9" text="도서산간"/>
                <Cell col="10" text="추가배송비"/>
                <Cell col="11" text="택배사"/>
                <Cell col="12" text="송장번호"/>
                <Cell col="13" text="출고일"/>
              </Band>
              <Band id="body">
                <Cell displaytype="checkboxcontrol" edittype="checkbox" text="bind:CHK"/>
                <Cell col="1" text="bind:DLV_NO"/>
                <Cell col="2" text="bind:ORD_NO"/>
                <Cell col="3" text="bind:ORD_DT" displaytype="date" calendardateformat="yyyy-MM-dd"/>
                <Cell col="4" text="bind:DLV_STAT_NM" textAlign="center"/>
                <Cell col="5" text="bind:RCV_NM"/>
                <Cell col="6" text="bind:RCV_HP"/>
                <Cell col="7" text="bind:RCV_ZIP" textAlign="center"/>
                <Cell col="8" text="bind:RCV_ADDR"/>
                <Cell col="9" text="bind:ISLAND_YN" textAlign="center"/>
                <Cell col="10" text="bind:ADD_FEE" displaytype="number" textAlign="right"/>
                <Cell col="11" text="bind:CARRIER_CD" displaytype="combocontrol" edittype="expr:DLV_STAT=='R'?'combo':'none'" combodataset="ds_carrier" combocodecol="CD" combodatacol="CD_NM"/>
                <Cell col="12" text="bind:INVC_NO" edittype="expr:DLV_STAT=='R'?'normal':'none'" editmaxlength="12"/>
                <Cell col="13" text="bind:SHIP_DT" displaytype="date" calendardateformat="yyyy-MM-dd"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_trace" taborder="21" text="배송 추적" left="20" top="548" width="300" height="26"/>
        <Grid id="grd_trace" taborder="22" binddataset="ds_trace" left="20" top="578" width="1240" height="162">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="60"/>
                <Column size="180"/>
                <Column size="200"/>
                <Column size="300"/>
              </Columns>
              <Rows>
                <Row size="30" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="순번"/>
                <Cell col="1" text="일시"/>
                <Cell col="2" text="상태"/>
                <Cell col="3" text="위치"/>
              </Band>
              <Band id="body">
                <Cell text="bind:TRACE_SEQ" textAlign="center"/>
                <Cell col="1" text="bind:TRACE_DT"/>
                <Cell col="2" text="bind:TRACE_STAT_NM"/>
                <Cell col="3" text="bind:TRACE_LOC"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="FROM_YMD" type="STRING" size="8"/>
          <Column id="TO_YMD" type="STRING" size="8"/>
          <Column id="DLV_STAT" type="STRING" size="1"/>
          <Column id="CARRIER_CD" type="STRING" size="10"/>
          <Column id="ORD_NO" type="STRING" size="20"/>
          <Column id="INVC_NO" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_dlvStatSrch">
        <ColumnInfo>
          <Column id="CD" type="STRING" size="1"/>
          <Column id="CD_NM" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CD"></Col><Col id="CD_NM">출고대기+배송중</Col></Row>
          <Row><Col id="CD">R</Col><Col id="CD_NM">출고대기</Col></Row>
          <Row><Col id="CD">S</Col><Col id="CD_NM">배송중</Col></Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_carrier">
        <ColumnInfo>
          <Column id="CD" type="STRING" size="10"/>
          <Column id="CD_NM" type="STRING" size="100"/>
          <Column id="CD_VAL1" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_dlv">
        <ColumnInfo>
          <Column id="CHK" type="STRING" size="1"/>
          <Column id="DLV_NO" type="STRING" size="20"/>
          <Column id="ORD_NO" type="STRING" size="20"/>
          <Column id="ORD_DT" type="STRING" size="8"/>
          <Column id="ORD_STAT" type="STRING" size="2"/>
          <Column id="MBR_ID" type="STRING" size="20"/>
          <Column id="DLV_STAT" type="STRING" size="1"/>
          <Column id="DLV_STAT_NM" type="STRING" size="20"/>
          <Column id="RCV_NM" type="STRING" size="50"/>
          <Column id="RCV_HP" type="STRING" size="20"/>
          <Column id="RCV_ZIP" type="STRING" size="5"/>
          <Column id="RCV_ADDR" type="STRING" size="200"/>
          <Column id="DLV_FEE" type="BIGDECIMAL" size="10"/>
          <Column id="ADD_FEE" type="BIGDECIMAL" size="10"/>
          <Column id="ISLAND_YN" type="STRING" size="1"/>
          <Column id="ISLAND_TYPE" type="STRING" size="10"/>
          <Column id="CARRIER_CD" type="STRING" size="10"/>
          <Column id="INVC_NO" type="STRING" size="20"/>
          <Column id="SHIP_DT" type="STRING" size="8"/>
          <Column id="DLV_CMPL_DT" type="STRING" size="8"/>
          <Column id="ITEM_CNT" type="INT" size="5"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_trace">
        <ColumnInfo>
          <Column id="DLV_NO" type="STRING" size="20"/>
          <Column id="TRACE_SEQ" type="INT" size="5"/>
          <Column id="TRACE_STAT" type="STRING" size="1"/>
          <Column id="TRACE_STAT_NM" type="STRING" size="50"/>
          <Column id="TRACE_LOC" type="STRING" size="100"/>
          <Column id="TRACE_DT" type="STRING" size="20"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_proc">
        <ColumnInfo>
          <Column id="CHK" type="STRING" size="1"/>
          <Column id="DLV_NO" type="STRING" size="20"/>
          <Column id="CARRIER_CD" type="STRING" size="10"/>
          <Column id="INVC_NO" type="STRING" size="20"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="cal_from" propid="value" datasetid="ds_search" columnid="FROM_YMD"/>
      <BindItem id="item1" compid="cal_to" propid="value" datasetid="ds_search" columnid="TO_YMD"/>
      <BindItem id="item2" compid="cbo_dlvStat" propid="value" datasetid="ds_search" columnid="DLV_STAT"/>
      <BindItem id="item3" compid="cbo_carrier" propid="value" datasetid="ds_search" columnid="CARRIER_CD"/>
      <BindItem id="item4" compid="edt_ordNo" propid="value" datasetid="ds_search" columnid="ORD_NO"/>
      <BindItem id="item5" compid="edt_invcNo" propid="value" datasetid="ds_search" columnid="INVC_NO"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[include "lib::common.xjs";

this.DlvMng_onload = function(obj, e)
{
	this.gfn_setCode("ds_carrier", "CARRIER");
	var today = this.gfn_today();
	var d = this.gfn_toDate(today);
	d.setDate(d.getDate() - 14);
	this.ds_search.setColumn(0, "FROM_YMD", d.getFullYear() + String(d.getMonth() + 1).padLeft(2, "0") + String(d.getDate()).padLeft(2, "0"));
	this.ds_search.setColumn(0, "TO_YMD", today);
	this.fn_search();
};

this.btn_search_onclick = function(obj, e)
{
	this.fn_search();
};

this.fn_search = function(bKeepTrace)
{
	if (bKeepTrace != true) {
		this.ds_trace.clearData();
	}
	this.gfn_callApi("dlv.list", "ds_search=ds_search", "ds_dlv=ds_dlv", "fn_callback");
};

/** 체크된 출고대기 건에 택배사 일괄 적용 */
this.btn_bulkCarrier_onclick = function(obj, e)
{
	var carrierCd = this.cbo_bulkCarrier.value;
	if (this.gfn_isEmpty(carrierCd)) {
		this.gfn_alert("적용할 택배사를 선택하세요.");
		return;
	}
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") == "1" && this.ds_dlv.getColumn(i, "DLV_STAT") == "R") {
			this.ds_dlv.setColumn(i, "CARRIER_CD", carrierCd);
		}
	}
};

this.btn_ship_onclick = function(obj, e)
{
	if (!this.fn_validateShip()) return;
	if (!this.gfn_confirm("선택한 " + this.fn_checkedCnt() + "건을 출고 처리하시겠습니까?")) return;

	this.ds_proc.clearData();
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") != "1") continue;
		var nRow = this.ds_proc.addRow();
		this.ds_proc.setColumn(nRow, "CHK", "1");
		this.ds_proc.setColumn(nRow, "DLV_NO", this.ds_dlv.getColumn(i, "DLV_NO"));
		this.ds_proc.setColumn(nRow, "CARRIER_CD", this.ds_dlv.getColumn(i, "CARRIER_CD"));
		this.ds_proc.setColumn(nRow, "INVC_NO", String(this.ds_dlv.getColumn(i, "INVC_NO")).replace(/-/g, ""));
	}
	this.gfn_callApi("dlv.ship", "ds_dlv=ds_proc", "", "fn_callback");
};

this.btn_complete_onclick = function(obj, e)
{
	if (this.fn_checkedCnt() == 0) {
		this.gfn_alert("배송완료 처리할 배송 건을 선택하세요.");
		return;
	}
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") != "1") continue;
		if (this.ds_dlv.getColumn(i, "DLV_STAT") != "S") {
			this.gfn_alert("배송중 상태만 배송완료 처리할 수 있습니다.\n(" + this.ds_dlv.getColumn(i, "DLV_NO") + ")");
			return;
		}
	}
	if (!this.gfn_confirm("선택한 " + this.fn_checkedCnt() + "건을 배송완료 처리하시겠습니까?\n배송완료일은 오늘로 등록됩니다.")) return;

	this.ds_proc.clearData();
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") != "1") continue;
		var nRow = this.ds_proc.addRow();
		this.ds_proc.setColumn(nRow, "CHK", "1");
		this.ds_proc.setColumn(nRow, "DLV_NO", this.ds_dlv.getColumn(i, "DLV_NO"));
	}
	this.gfn_callApi("dlv.complete", "ds_dlv=ds_proc", "", "fn_callback");
};

this.btn_track_onclick = function(obj, e)
{
	var nRow = this.ds_dlv.rowposition;
	if (nRow < 0) {
		this.gfn_alert("조회할 배송 건을 선택하세요.");
		return;
	}
	if (this.gfn_isEmpty(this.ds_dlv.getColumn(nRow, "INVC_NO")) || this.ds_dlv.getColumn(nRow, "DLV_STAT") == "R") {
		this.gfn_alert("출고된 배송 건만 조회할 수 있습니다.");
		return;
	}
	this.ds_proc.clearData();
	var pRow = this.ds_proc.addRow();
	this.ds_proc.setColumn(pRow, "DLV_NO", this.ds_dlv.getColumn(nRow, "DLV_NO"));
	this.sta_trace.set_text("배송 추적 - " + this.ds_dlv.getColumn(nRow, "INVC_NO"));
	this.gfn_callApi("dlv.track", "ds_dlv=ds_proc", "ds_trace=ds_trace", "fn_callback");
};

this.fn_checkedCnt = function()
{
	var cnt = 0;
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") == "1") cnt++;
	}
	return cnt;
};

/** 출고 검사: 출고대기만, 택배사 필수, 송장번호 숫자 10~12자리 */
this.fn_validateShip = function()
{
	if (this.fn_checkedCnt() == 0) {
		this.gfn_alert("출고할 배송 건을 선택하세요.");
		return false;
	}
	var re = /^[0-9]{10,12}$/;
	for (var i = 0; i < this.ds_dlv.rowcount; i++) {
		if (this.ds_dlv.getColumn(i, "CHK") != "1") continue;
		var dlvNo = this.ds_dlv.getColumn(i, "DLV_NO");
		if (this.ds_dlv.getColumn(i, "DLV_STAT") != "R") {
			this.gfn_alert("출고대기 상태만 출고할 수 있습니다.\n(" + dlvNo + ")");
			return false;
		}
		if (this.gfn_isEmpty(this.ds_dlv.getColumn(i, "CARRIER_CD"))) {
			this.gfn_alert("택배사를 선택하세요.\n(" + dlvNo + ")");
			this.ds_dlv.set_rowposition(i);
			return false;
		}
		var invcNo = String(this.gfn_nvl(this.ds_dlv.getColumn(i, "INVC_NO"), "")).replace(/-/g, "");
		if (this.gfn_isEmpty(invcNo)) {
			this.gfn_alert("송장번호를 입력하세요.\n(" + dlvNo + ")");
			this.ds_dlv.set_rowposition(i);
			return false;
		}
		if (!re.test(invcNo)) {
			this.gfn_alert("송장번호는 숫자 10~12자리입니다.\n(" + dlvNo + ")");
			this.ds_dlv.set_rowposition(i);
			return false;
		}
	}
	return true;
};

this.fn_callback = function(svcId, errorCode, errorMsg)
{
	if (errorCode < 0) {
		this.gfn_alert(errorMsg);
		return;
	}
	if (svcId == "dlv.ship") {
		this.gfn_alert("출고 처리되었습니다.");
		this.fn_search();
	} else if (svcId == "dlv.complete") {
		this.gfn_alert("배송완료 처리되었습니다.");
		this.fn_search();
	} else if (svcId == "dlv.track") {
		var last = this.ds_trace.rowcount - 1;
		var nRow = this.ds_dlv.rowposition;
		if (last >= 0 && this.ds_trace.getColumn(last, "TRACE_STAT") == "D"
				&& nRow >= 0 && this.ds_dlv.getColumn(nRow, "DLV_STAT") == "S") {
			this.gfn_alert("배달완료 확인되어 배송완료 처리되었습니다.");
			this.fn_search(true);
		}
	}
};
]]></Script>
  </Form>
</FDL>
