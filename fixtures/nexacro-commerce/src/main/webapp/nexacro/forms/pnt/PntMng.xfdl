<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="PntMng" width="1280" height="720" titletext="포인트 관리" onload="PntMng_onload">
    <Layouts>
      <Layout height="720" width="1280">
        <Static id="sta_title" taborder="0" text="포인트 관리" left="20" top="12" width="200" height="30"/>
        <Static id="sta_mbrId" taborder="1" text="회원ID" left="20" top="56" width="54" height="28"/>
        <Edit id="edt_mbrId" taborder="2" left="78" top="56" width="140" height="28" onkeyup="edt_mbrId_onkeyup"/>
        <Static id="sta_pntType" taborder="3" text="거래유형" left="234" top="56" width="64" height="28"/>
        <Combo id="cbo_pntType" taborder="4" left="302" top="56" width="120" height="28" innerdataset="ds_pntType" codecolumn="CD" datacolumn="CD_NM"/>
        <Static id="sta_regDt" taborder="5" text="거래일" left="438" top="56" width="50" height="28"/>
        <Calendar id="cal_fromDt" taborder="6" left="492" top="56" width="120" height="28" dateformat="yyyy-MM-dd"/>
        <Static id="sta_tilde" taborder="7" text="~" left="616" top="56" width="14" height="28"/>
        <Calendar id="cal_toDt" taborder="8" left="634" top="56" width="120" height="28" dateformat="yyyy-MM-dd"/>
        <Static id="sta_ordNo" taborder="9" text="주문번호" left="770" top="56" width="64" height="28"/>
        <Edit id="edt_ordNo" taborder="10" left="838" top="56" width="160" height="28"/>
        <Button id="btn_search" taborder="11" text="조회" left="1184" top="56" width="76" height="28" onclick="btn_search_onclick"/>
        <Static id="sta_mbrInfo" taborder="12" text="" left="20" top="96" width="560" height="28"/>
        <Static id="sta_balAmt" taborder="13" text="" left="590" top="96" width="300" height="28"/>
        <Grid id="grd_ledger" taborder="14" binddataset="ds_ledger" left="20" top="132" width="880" height="568">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="140"/>
                <Column size="80"/>
                <Column size="90"/>
                <Column size="90"/>
                <Column size="90"/>
                <Column size="140"/>
                <Column size="84"/>
                <Column size="140"/>
                <Column size="160"/>
              </Columns>
              <Rows>
                <Row size="30" band="head"/>
                <Row size="30"/>
              </Rows>
              <Band id="head">
                <Cell text="원장번호"/>
                <Cell col="1" text="유형"/>
                <Cell col="2" text="포인트"/>
                <Cell col="3" text="잔여"/>
                <Cell col="4" text="누계"/>
                <Cell col="5" text="주문번호"/>
                <Cell col="6" text="유효기간"/>
                <Cell col="7" text="거래일시"/>
                <Cell col="8" text="비고"/>
              </Band>
              <Band id="body">
                <Cell text="bind:LEDGER_NO"/>
                <Cell col="1" text="bind:PNT_TYPE_NM"/>
                <Cell col="2" text="bind:PNT_AMT" displaytype="number" textAlign="right" color="expr:PNT_AMT &lt; 0 ? 'red' : 'blue'"/>
                <Cell col="3" text="bind:REMAIN_AMT" displaytype="number" textAlign="right"/>
                <Cell col="4" text="bind:CUM_AMT" displaytype="number" textAlign="right"/>
                <Cell col="5" text="bind:ORD_NO"/>
                <Cell col="6" text="bind:EXP_DT" displaytype="date" calendardateformat="yyyy-MM-dd"/>
                <Cell col="7" text="bind:REG_DT"/>
                <Cell col="8" text="bind:RMK"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_adjTitle" taborder="15" text="포인트 조정" left="920" top="132" width="200" height="28"/>
        <Static id="sta_adjType" taborder="16" text="구분" left="920" top="168" width="70" height="28"/>
        <Radio id="rdo_adjType" taborder="17" left="994" top="168" width="200" height="28" innerdataset="ds_adjType" codecolumn="CD" datacolumn="CD_NM" direction="horizontal" value="P"/>
        <Static id="sta_adjAmt" taborder="18" text="포인트" left="920" top="204" width="70" height="28"/>
        <MaskEdit id="msk_adjAmt" taborder="19" left="994" top="204" width="160" height="28" format="#,###" type="number"/>
        <Static id="sta_rmk" taborder="20" text="사유" left="920" top="240" width="70" height="28"/>
        <TextArea id="txa_rmk" taborder="21" left="994" top="240" width="266" height="80"/>
        <Button id="btn_adjust" taborder="22" text="조정" left="1184" top="330" width="76" height="28" onclick="btn_adjust_onclick"/>
        <Static id="sta_rateTitle" taborder="23" text="등급별 적립률 안내" left="920" top="380" width="200" height="28"/>
        <Grid id="grd_pntRate" taborder="24" binddataset="ds_pntRate" left="920" top="412" width="340" height="156">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="130"/>
                <Column size="130"/>
              </Columns>
              <Rows>
                <Row size="30" band="head"/>
                <Row size="30"/>
              </Rows>
              <Band id="head">
                <Cell text="등급"/>
                <Cell col="1" text="등급명"/>
                <Cell col="2" text="적립률"/>
              </Band>
              <Band id="body">
                <Cell text="bind:CD"/>
                <Cell col="1" text="bind:CD_NM"/>
                <Cell col="2" text="expr:CD_VAL1 + '%'" textAlign="right"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_rateGuide" taborder="25" text="" left="920" top="576" width="340" height="44" wordWrap="char"/>
        <Static id="sta_rateNote" taborder="26" text="※ 구매확정 시 결제금액(배송비 제외) 기준 적립, 유효기간 12개월" left="920" top="624" width="340" height="44" wordWrap="char"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="MBR_ID" type="STRING" size="20"/>
          <Column id="PNT_TYPE" type="STRING" size="10"/>
          <Column id="ORD_NO" type="STRING" size="20"/>
          <Column id="FROM_DT" type="STRING" size="8"/>
          <Column id="TO_DT" type="STRING" size="8"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_ledger">
        <ColumnInfo>
          <Column id="LEDGER_NO" type="STRING" size="20"/>
          <Column id="PNT_TYPE" type="STRING" size="10"/>
          <Column id="PNT_TYPE_NM" type="STRING" size="50"/>
          <Column id="PNT_AMT" type="BIGDECIMAL" size="12"/>
          <Column id="REMAIN_AMT" type="BIGDECIMAL" size="12"/>
          <Column id="CUM_AMT" type="BIGDECIMAL" size="12"/>
          <Column id="ORD_NO" type="STRING" size="20"/>
          <Column id="ORG_LEDGER_NO" type="STRING" size="20"/>
          <Column id="EXP_DT" type="STRING" size="8"/>
          <Column id="REG_DT" type="STRING" size="20"/>
          <Column id="RMK" type="STRING" size="500"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_bal">
        <ColumnInfo>
          <Column id="MBR_ID" type="STRING" size="20"/>
          <Column id="MBR_NM" type="STRING" size="50"/>
          <Column id="GRADE_CD" type="STRING" size="10"/>
          <Column id="BAL_AMT" type="BIGDECIMAL" size="12"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_adjust">
        <ColumnInfo>
          <Column id="MBR_ID" type="STRING" size="20"/>
          <Column id="ADJ_AMT" type="BIGDECIMAL" size="12"/>
          <Column id="RMK" type="STRING" size="500"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_adjType">
        <ColumnInfo>
          <Column id="CD" type="STRING" size="1"/>
          <Column id="CD_NM" type="STRING" size="10"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CD">P</Col><Col id="CD_NM">지급</Col></Row>
          <Row><Col id="CD">M</Col><Col id="CD_NM">회수</Col></Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_pntType"/>
      <Dataset id="ds_pntRate"/>
      <Dataset id="ds_grade"/>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="edt_mbrId" propid="value" datasetid="ds_search" columnid="MBR_ID"/>
      <BindItem id="item1" compid="cbo_pntType" propid="value" datasetid="ds_search" columnid="PNT_TYPE"/>
      <BindItem id="item2" compid="cal_fromDt" propid="value" datasetid="ds_search" columnid="FROM_DT"/>
      <BindItem id="item3" compid="cal_toDt" propid="value" datasetid="ds_search" columnid="TO_DT"/>
      <BindItem id="item4" compid="edt_ordNo" propid="value" datasetid="ds_search" columnid="ORD_NO"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[include "lib::common.xjs";

this.PntMng_onload = function(obj, e)
{
	this.gfn_setCode("ds_pntType", "PNT_TYPE");
	this.gfn_setCode("ds_pntRate", "PNT_RATE");
	this.gfn_setCode("ds_grade", "MBR_GRADE");

	var today = this.gfn_today();
	this.ds_search.setColumn(0, "FROM_DT", today.substr(0, 4) + "0101");
	this.ds_search.setColumn(0, "TO_DT", today);
};

this.edt_mbrId_onkeyup = function(obj, e)
{
	if (e.keycode == 13) {
		this.fn_search();
	}
};

this.btn_search_onclick = function(obj, e)
{
	this.fn_search();
};

this.fn_search = function()
{
	if (this.gfn_isEmpty(this.ds_search.getColumn(0, "MBR_ID"))) {
		this.gfn_alert("회원ID를 입력하세요.");
		this.edt_mbrId.setFocus();
		return;
	}
	this.gfn_callApi("pnt.list", "ds_search=ds_search", "ds_ledger=ds_ledger ds_bal=ds_bal", "fn_callback");
};

/** 적립률 안내 문구 (공통코드 PNT_RATE 기준) */
this.fn_setRateGuide = function()
{
	var arr = [];
	for (var i = 0; i < this.ds_pntRate.rowcount; i++) {
		arr.push(this.ds_pntRate.getColumn(i, "CD_NM") + " " + this.ds_pntRate.getColumn(i, "CD_VAL1") + "%");
	}
	this.sta_rateGuide.set_text("등급별 적립률: " + arr.join(" / "));
};

this.fn_setMbrInfo = function()
{
	if (this.ds_bal.rowcount == 0) {
		this.sta_mbrInfo.set_text("");
		this.sta_balAmt.set_text("");
		return;
	}
	var gradeCd = this.ds_bal.getColumn(0, "GRADE_CD");
	var gradeNm = this.gfn_getCodeVal(this.ds_grade, gradeCd);
	var rate    = this.gfn_getCodeVal(this.ds_pntRate, gradeCd, "CD_VAL1");
	this.sta_mbrInfo.set_text(this.ds_bal.getColumn(0, "MBR_NM") + " (" + this.ds_bal.getColumn(0, "MBR_ID") + ")"
		+ "  등급: " + gradeNm + "  적립률: " + rate + "%");
	this.sta_balAmt.set_text("현재 잔액: " + this.gfn_numFormat(this.gfn_nvl(this.ds_bal.getColumn(0, "BAL_AMT"), 0)) + " P");
};

this.btn_adjust_onclick = function(obj, e)
{
	if (!this.fn_validateAdjust()) {
		return;
	}
	var adjType = this.rdo_adjType.value;
	var amt = nexacro.toNumber(this.msk_adjAmt.value);
	var msg = (adjType == "P" ? "지급" : "회수") + " " + this.gfn_numFormat(amt) + "P 를 처리하시겠습니까?";
	if (!this.gfn_confirm(msg)) {
		return;
	}
	this.ds_adjust.clearData();
	var nRow = this.ds_adjust.addRow();
	this.ds_adjust.setColumn(nRow, "MBR_ID", this.ds_bal.getColumn(0, "MBR_ID"));
	this.ds_adjust.setColumn(nRow, "ADJ_AMT", adjType == "P" ? amt : -amt);
	this.ds_adjust.setColumn(nRow, "RMK", this.txa_rmk.value);
	this.gfn_callApi("pnt.adjust", "ds_adjust=ds_adjust", "", "fn_callback",
		"USER_ID=" + nexacro.getApplication().gv_userId);
};

this.fn_validateAdjust = function()
{
	if (this.ds_bal.rowcount == 0) {
		this.gfn_alert("회원을 먼저 조회하세요.");
		return false;
	}
	var amt = nexacro.toNumber(this.gfn_nvl(this.msk_adjAmt.value, 0));
	if (amt <= 0) {
		this.gfn_alert("조정 포인트를 입력하세요.");
		this.msk_adjAmt.setFocus();
		return false;
	}
	if (this.gfn_isEmpty(this.txa_rmk.value)) {
		this.gfn_alert("조정 사유를 입력하세요.");
		this.txa_rmk.setFocus();
		return false;
	}
	if (this.rdo_adjType.value == "M") {
		var bal = nexacro.toNumber(this.gfn_nvl(this.ds_bal.getColumn(0, "BAL_AMT"), 0));
		if (amt > bal) {
			this.gfn_alert("회수 포인트가 현재 잔액(" + this.gfn_numFormat(bal) + "P)을 초과합니다.");
			return false;
		}
	}
	return true;
};

this.fn_callback = function(svcId, errorCode, errorMsg)
{
	if (errorCode < 0) {
		this.gfn_alert(errorMsg);
		return;
	}
	if (svcId == "pnt.list") {
		this.fn_setMbrInfo();
		this.fn_setRateGuide();
	} else if (svcId == "pnt.adjust") {
		this.gfn_alert("조정되었습니다.");
		this.msk_adjAmt.set_value("");
		this.txa_rmk.set_value("");
		this.fn_search();
	}
};
]]></Script>
  </Form>
</FDL>
